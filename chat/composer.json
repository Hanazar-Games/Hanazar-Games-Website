{
    "name": "hanazar/private-chat",
    "description": "Private self-hosted messaging service",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Hanazar\\Chat\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hanazar\\Chat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
