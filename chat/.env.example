APP_ENV=production
APP_ORIGIN=https://chat.hanazargames.com
APP_HOST=chat.hanazargames.com
APP_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES
PUBLIC_ROOT=/srv/hanazar-chat/current/public
DB_PATH=/srv/hanazar-chat/shared/data/chat.sqlite
SESSION_PATH=/srv/hanazar-chat/shared/sessions
LOG_PATH=/srv/hanazar-chat/shared/logs
RATE_LIMIT_PATH=/srv/hanazar-chat/shared/rate-limits
BACKUP_PATH=/srv/hanazar-chat/shared/backups
TRUSTED_PROXIES=127.0.0.1,::1
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
