# Copy to /etc/flash-photo.env in production; never commit real values.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://s.hanazargames.com
APP_TIMEZONE=Asia/Shanghai

DATABASE_PATH=/var/lib/flash-photo/database.sqlite
STORAGE_PATH=/var/lib/flash-photo/images
LOG_PATH=/var/log/flash-photo
RATE_LIMIT_PATH=/var/lib/flash-photo/rate-limits

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
DEFAULT_VIEW_SECONDS=30
DEFAULT_UNUSED_EXPIRY_SECONDS=86400
REENCODE_UPLOADS=true
PRESERVE_GIF_ANIMATION=true

SESSION_NAME=__Secure-flash_admin
SESSION_LIFETIME=3600
APP_SECRET=CHANGE_ME
IP_HASH_SECRET=CHANGE_ME
HEALTH_TOKEN=CHANGE_ME
TRUSTED_PROXIES=
# Keep this URL segment synchronized with the three public admin route regexes in Nginx.
ADMIN_PATH=admin

LOG_RETENTION_DAYS=30
DESTROYED_RECORD_RETENTION_DAYS=90

# Anonymous admin-session admissions per IP hash / window seconds, enforced before session creation.
RATE_ADMIN_SESSION_LIMIT=30
RATE_ADMIN_SESSION_WINDOW=60
RATE_LOGIN_LIMIT=10
RATE_LOGIN_WINDOW=900
RATE_REDEEM_LIMIT=30
RATE_REDEEM_WINDOW=60
RATE_CONTENT_LIMIT=120
RATE_CONTENT_WINDOW=60
RATE_STATUS_LIMIT=120
RATE_STATUS_WINDOW=60
RATE_UPLOAD_LIMIT=20
RATE_UPLOAD_WINDOW=3600
RATE_PROBE_LIMIT=20
RATE_PROBE_WINDOW=60
