{
  "name": "hanazar/flash-photo",
  "description": "Private server-enforced expiring image sharing",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-session": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "ext-gd": "Required when upload re-encoding is enabled"
  },
  "autoload": {
    "psr-4": {
      "FlashPhoto\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FlashPhoto\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "config": {
    "sort-packages": true
  }
}
